{
  "name": "pi-flow",
  "productName": "Pi Flow",
  "version": "1.1.0",
  "private": true,
  "description": "项目级 Pi Agent 节点编排",
  "type": "module",
  "main": "electron-ipc/main.mjs",
  "scripts": {
    "start": "electron .",
    "dev": "node server/main.mjs",
    "preview:setup": "electron scripts/setup-ui/setup-preview.mjs",
    "check": "node scripts/dev/check-syntax.mjs",
    "test": "node scripts/dev/check-syntax.mjs && node scripts/dev/run-tests.mjs",
    "test:server": "node scripts/dev/run-tests.mjs server",
    "test:ui": "node scripts/dev/run-tests.mjs ui",
    "fetch:bundles": "node scripts/build/fetch-bundles.mjs",
    "check:bundles": "node scripts/build/fetch-bundles.mjs --check",
    "pack": "node scripts/build/fetch-bundles.mjs --check && electron-builder --win && node scripts/build/clean-release.mjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.piflow.desktop",
    "productName": "Pi Flow",
    "electronLanguages": ["zh-CN", "en-US"],
    "compression": "normal",
    "files": ["electron-ipc/**/*", "app/**/*", "modules/**/*", "server/**/*", "shared/**/*", "package.json"],
    "extraResources": [
      { "from": "shard", "to": "shard", "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"] },
      { "from": "shared", "to": "shared", "filter": ["**/*.mjs"] },
      {
        "from": "agents",
        "to": "agents",
        "filter": ["**/*", "!**/.pi/flow/**", "!**/extensions.legacy/**", "!**/__pycache__/**", "!**/*.pyc"]
      },
      { "from": "scripts", "to": "scripts", "filter": ["**/*", "!dev/**/*", "!build/**/*"] },
      { "from": "resources/bundles", "to": "bundles" },
      { "from": "presets", "to": "presets" },
      { "from": "resources/blender", "to": "blender" }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon/pi-flow-icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "include": "scripts/installer/installer.nsh",
      "installerLanguages": [
        "en_US"
      ],
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pi Flow",
      "deleteAppDataOnUninstall": false
    }
  }
}
