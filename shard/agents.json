{
  "_comment": "sync.mjs 的工具目录与默认值。每个 agent 的实际配置在 <项目>/.pi/agent.json（唯一配置源）；缺失时 sync 会按本清单的 profile + settings 生成一次。settings.json / pi-flow.json 均由 sync 生成，不要手改。SKILL.md 由人手动放到项目 .pi/skills/，sync 不碰。projects[].path 相对本目录（shard/）。改完跑 node sync.mjs sync [项目]。",

  "defaults": {
    "defaultProvider": "deepseek",
    "defaultModel": "deepseek-flash",
    "defaultTools": ["read", "bash", "edit", "write"]
  },

  "tools": {
    "bpy": "extensions/bpy.ts",
    "py": "extensions/py.ts",
    "blender": "extensions/blender.ts",
    "blender_build": "extensions/blender_build.ts",
    "blender_data": "extensions/blender_data.ts",
    "blender_fit": "extensions/blender_fit.ts",
    "blender_math": "extensions/blender_math.ts",
    "blender_screen": "extensions/blender_screen.ts",
    "node_query": "extensions/node_query.ts",
    "mesh_probe": "extensions/mesh_probe.ts",
    "covtrace": "extensions/covtrace.ts",
    "wf_plan": "extensions/wf_plan.ts",
    "hook_skill": "extensions/hook_skill.ts"
  },

  "profiles": {
    "full": [
      "bpy", "py", "blender", "blender_build", "blender_data", "blender_fit", "blender_math",
      "blender_screen", "node_query", "mesh_probe", "covtrace", "wf_plan", "hook_skill"
    ],
    "scout": ["bpy", "blender", "blender_data", "blender_screen", "node_query"],
    "execute": ["blender", "blender_build", "blender_math", "blender_screen", "node_query"],
    "covtrace": ["blender", "blender_screen", "covtrace", "node_query"],
    "modeling": [],
    "translate": ["node_query", "blender_build", "wf_plan", "mesh_probe", "py", "blender_fit"],
    "Single": [ "bpy", "blender", "blender_build",  "blender_math","blender_screen", "node_query", "wf_plan", "hook_skill"],
    "none": []
  },

  "projects": {
    "GEO_Single": { "profile": "Single", "path": "../agents/GEO_Single", "isolate": true, "displayName": "单人", "register": false },
    "GEO_Scout": { "profile": "scout", "path": "../agents/GEO_Scout", "isolate": true, "displayName": "侦察者" },
    "GEO_Execute": { "profile": "execute", "path": "../agents/GEO_Execute", "isolate": true, "displayName": "执行者" },
    "GEO_Covtrace": { "profile": "covtrace", "path": "../agents/GEO_Covtrace", "isolate": true, "displayName": "探索者" },
    "Geo_Modeling": { "profile": "modeling", "path": "../agents/Geo_Modeling", "isolate": true, "displayName": "规划者" },
    "GEO_Translate": { "profile": "translate", "path": "../agents/GEO_Translate", "isolate": true, "displayName": "翻译者" }
  }
}
